<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="submit.html">
        <label for="Aadhaar">Aadhaar:</label>
        <input type="text" pattern="[0-9]{12}" id="Aadhaar" required><br>
        <label for="Pancard">Pancard:</label>
        <input type="text" pattern="[A-Z]{5}[0-9]{4}[A-Z]" id="Pancard" required><br>
        <label for="Bank AC number">Bank AC number:</label>
        <input type="text" pattern="[0-9]{13}" id="Bank AC number" required><br>
        <input type="submit">
    </form>
</body>
</html>
